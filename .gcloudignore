# Source upload for Cloud Build: only what the Dockerfile copies (keeps the upload small and secrets out)
*
!Dockerfile
!requirements.txt
!cli.py
!backend/**
!assets/**
!deploy/fetch_fonts.sh
!web/package.json
!web/package-lock.json
!web/src/**
!web/public/**
!web/*.ts
!web/*.mjs
!web/*.json
web/node_modules
web/.next
web/out
